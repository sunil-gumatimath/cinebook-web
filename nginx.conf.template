server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---------- API ----------
    # The Vite build points the client at /api (VITE_API_BASE_URL), so the
    # browser stays on one origin and CORS never applies. Requests are
    # rewritten to strip the /api prefix, matching the backend, which serves
    # its controllers at the root (/login, /movies, ...) with no context path.
    #
    # The upstream is written literally so nginx resolves it at startup; using
    # a runtime variable here would require a resolver directive to work with
    # Docker's embedded DNS.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
    }

    # ---------- Swagger UI ----------
    # Proxied so the OpenAPI docs are reachable on the frontend origin.
    # Swagger resolves /v3/api-docs absolutely, so both paths are forwarded.
    location /swagger-ui {
        rewrite ^/swagger-ui/index\.html$ /swagger-ui/index.html break;
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_set_header Host $host;
    }

    location /v3/api-docs {
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_set_header Host $host;
    }

    # ---------- Static assets ----------
    # Vite emits content-hashed filenames, so these are safe to cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # ---------- SPA fallback ----------
    # React Router uses BrowserRouter, so every unknown path must serve
    # index.html and let the client-side router resolve the route.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/xml font/woff2;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
}
